# ---------------------------------------------------------------------------
# Runtime data. The published Zenodo artifact is the distribution mechanism;
# the local trees below are regeneration/audit inputs and must never be
# committed (~3.8 GB).
# ---------------------------------------------------------------------------
data/
artifact_staging/
*_depot*/

# Julia
Manifest.toml
Manifest-v*.toml
/docs/build/
/docs/Manifest.toml
*.cov
*.jl.mem
deps/deps.jl
LocalPreferences.toml

# Local artifact extractions and archives
Artifacts/
artifacts/
*.tar
*.tar.gz
*.tar.xz
*.tgz
*.txz
*.zip
*.7z

